# ==================================
# DADOS
# ==================================
# Ignora dados brutos em qualquer pasta "dados/raw" ou "data/raw",
# tanto na raiz como dentro de cada pasta de projeto.
**/data/raw/*
**/dados/raw/*
!**/data/raw/.gitkeep
!**/dados/raw/.gitkeep

# Permitir dados de exemplo (fora da pasta raw)
!**/data/sample_data.csv
!**/data/sample_data.xlsx

# ==================================
# OFFICE (ficheiros de lock temporários)
# ==================================
~$*.docx
~$*.pptx
~$*.xlsx

# ==================================
# POWER BI
# ==================================
*.pbix.bak

# ==================================
# PYTHON
# ==================================
__pycache__/
*.pyc
.venv/
venv/
.env

# ==================================
# JUPYTER
# ==================================
.ipynb_checkpoints/

# ==================================
# LOGS E TEMPORÁRIOS
# ==================================
*.log
*.tmp

# ==================================
# SISTEMA
# ==================================
.DS_Store
Thumbs.db

# ==================================
# EDITORES
# ==================================
.vscode/
.idea/
